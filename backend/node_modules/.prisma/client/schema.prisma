generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Institution {
  id            String                  @id @default(uuid()) @db.Uuid
  name          String
  type          InstitutionType
  address       String?
  phone         String?
  email         String?
  website       String?
  createdBy     String?                 @map("created_by") @db.Uuid
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  classrooms    Classroom[]
  subscriptions Subscription[]
  users         User[]
  gameConfigs   GameInstitutionConfig[]

  @@map("institutions")
}

model User {
  id                String            @id @default(uuid()) @db.Uuid
  email             String            @unique
  password          String
  fullName          String            @map("full_name")
  role              UserRole
  isActive          Boolean           @default(true)
  lastLoginAt       DateTime?         @map("last_login_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  institutionId     String?           @map("institution_id") @db.Uuid
  parentId          String?           @map("parent_id") @db.Uuid
  childClassrooms   ClassroomChild[]
  teacherClassrooms Classroom[]       @relation("ClassroomTeacher")
  childProgress     Progress[]
  studentChildren   Student[]         @relation("StudentParent")
  student           Student?
  tutorClassrooms   TutorClassroom[]
  achievements      UserAchievement[]
  institution       Institution?      @relation(fields: [institutionId], references: [id])
  parent            User?             @relation("UserParent", fields: [parentId], references: [id])
  children          User[]            @relation("UserParent")

  @@map("users")
}

model Student {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @unique @map("user_id") @db.Uuid
  parentId    String?    @map("parent_id") @db.Uuid
  classroomId String?    @map("classroom_id") @db.Uuid
  gradeLevel  String     @map("grade_level")
  birthDate   DateTime   @map("birth_date")
  createdAt   DateTime   @default(now()) @map("created_at")
  classroom   Classroom? @relation(fields: [classroomId], references: [id])
  parent      User?      @relation("StudentParent", fields: [parentId], references: [id])
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("students")
}

model Classroom {
  id            String           @id @default(uuid()) @db.Uuid
  name          String
  gradeLevel    String?          @map("grade_level")
  description   String?
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  institutionId String           @map("institution_id") @db.Uuid
  teacherId     String?          @map("teacher_id") @db.Uuid
  activities    Activity[]
  children      ClassroomChild[]
  institution   Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  teacher       User?            @relation("ClassroomTeacher", fields: [teacherId], references: [id])
  students      Student[]
  tutors        TutorClassroom[]

  @@map("classrooms")
}

model TutorClassroom {
  userId      String    @db.Uuid
  classroomId String    @db.Uuid
  createdAt   DateTime  @default(now())
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, classroomId])
  @@map("tutor_classrooms")
}

model ClassroomChild {
  userId      String    @db.Uuid
  classroomId String    @db.Uuid
  joinedAt    DateTime  @default(now())
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, classroomId])
  @@map("classroom_children")
}

model GameCategory {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @unique
  description  String?
  color        String?
  iconUrl      String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  achievements Achievement[]
  games        Game[]

  @@map("game_categories")
}

model Game {
  id                 String                  @id @default(uuid()) @db.Uuid
  name               String
  description        String?
  difficulty         GameDifficulty
  minAge             Int
  maxAge             Int
  estimatedDuration  Int
  instructions       String
  config             Json
  thumbnailUrl       String?
  isActive           Boolean                 @default(true)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  categoryId         String                  @db.Uuid
  achievements       Achievement[]
  activities         Activity[]
  category           GameCategory            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  progress           Progress[]
  institutionConfigs GameInstitutionConfig[]

  @@map("games")
}

model Activity {
  id          String         @id @default(uuid()) @db.Uuid
  name        String
  description String?
  status      ActivityStatus @default(PENDING)
  startDate   DateTime?
  endDate     DateTime?
  config      Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  classroomId String         @db.Uuid
  gameId      String         @db.Uuid
  classroom   Classroom      @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  game        Game           @relation(fields: [gameId], references: [id], onDelete: Cascade)
  progress    Progress[]

  @@map("activities")
}

model Progress {
  id         String    @id @default(uuid()) @db.Uuid
  score      Float?
  timeSpent  Int?
  completed  Boolean   @default(false)
  attempts   Int       @default(1)
  gameData   Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  userId     String    @db.Uuid
  gameId     String    @db.Uuid
  activityId String?   @db.Uuid
  activity   Activity? @relation(fields: [activityId], references: [id])
  game       Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("progress")
}

model Achievement {
  id               String            @id @default(uuid()) @db.Uuid
  name             String
  description      String
  type             AchievementType
  criteria         Json
  iconUrl          String?
  points           Int               @default(0)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  gameId           String?           @db.Uuid
  categoryId       String?           @db.Uuid
  category         GameCategory?     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  game             Game?             @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userAchievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  userId        String      @db.Uuid
  achievementId String      @db.Uuid
  unlockedAt    DateTime    @default(now())
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, achievementId])
  @@map("user_achievements")
}

model Plan {
  id            String         @id @default(uuid()) @db.Uuid
  planName      String         @unique @map("plan_name")
  name          String
  planType      String         @map("plan_type")
  minStudents   Int?           @map("min_students")
  maxStudents   Int?           @map("max_students")
  priceMonth    Float          @map("price_month")
  description   String?
  features      Json?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id            String      @id @default(uuid()) @db.Uuid
  institutionId String      @map("institution_id") @db.Uuid
  planId        String      @map("plan_id") @db.Uuid
  startDate     DateTime    @default(now()) @map("start_date")
  endDate       DateTime    @map("end_date")
  active        Boolean     @default(true)
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  plan          Plan        @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  TUTOR
  CHILD
}

enum InstitutionType {
  SCHOOL
  HOME
}

enum GameDifficulty {
  EASY
  MEDIUM
  HARD
}

enum ActivityStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AchievementType {
  COMPLETION
  PERFORMANCE
  CONSISTENCY
  SPECIAL
}

model GameInstitutionConfig {
  id             String   @id @default(uuid()) @db.Uuid
  gameId         String   @map("game_id") @db.Uuid
  institutionId  String   @map("institution_id") @db.Uuid
  isEnabled      Boolean  @default(true) @map("is_enabled")
  customConfig   Json?    @map("custom_config")
  deviceSettings Json?    @map("device_settings")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relaciones
  game        Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  // Índices únicos
  @@unique([gameId, institutionId])
  @@map("game_institution_configs")
}
